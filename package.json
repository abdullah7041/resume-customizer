{
  "name": "resume-customizer",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fast": "vite",
    "predev:netlify": "vite optimize",
    "dev:netlify": "netlify dev",
    "build": "node scripts/build.mjs",
    "build:vite": "vite build",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type:check": "tsc --noEmit && tsc -p netlify/tsconfig.json --noEmit",
    "quality:check": "npm run lint && npm run type:check && npm run test",
    "quality:parallel": "npm-run-all --parallel lint type:check test",
    "quality:full": "npm run quality:parallel && npm run build && npm run i18n:validate",
    "quality:fix": "npm run lint:fix && npm run type:check && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:ai": "tsx scripts/benchmark-ai-models.mjs",
    "eval:optimize": "tsx scripts/optimize-quality-eval.mjs",
    "eval:parse": "tsx scripts/parse-eval.mjs",
    "i18n:validate": "node scripts/i18n-validate.mjs",
    "i18n:missing": "node scripts/i18n-missing.mjs",
    "i18n:translation-prompt": "node scripts/i18n-translation-prompt.mjs",
    "prepare": "husky",
    "cleanup": "node -e \"const fs=require('fs');const files=['unified-pipeline.js','test-local.sh','test-parse-resume.ps1','debug_output.png','deno.lock','scripts/debug-gemini.js','LOCAL_TESTING_GUIDE.md'];files.forEach(f=>{try{fs.unlinkSync(f);console.log('Deleted:',f)}catch(e){if(e.code!=='ENOENT')console.error('Error:',f,e.message)}});console.log('Cleanup complete!')\""
  },
  "dependencies": {
    "@netlify/functions": "^5.2.0",
    "@sentry/node": "^10.65.0",
    "@sentry/react": "^10.65.0",
    "@supabase/supabase-js": "^2.110.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.42.2",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-cookie": "^3.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.577.0",
    "mixpanel-browser": "^2.81.0",
    "nanoid": "^5.1.16",
    "pdfjs-dist": "^5.7.284",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^17.0.9",
    "react-joyride": "^3.2.0",
    "resend": "^6.17.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@sparticuz/chromium": "^143.0.4",
    "puppeteer-core": "^24.43.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@netlify/dev": "^4.18.9",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.23",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "puppeteer": "^24.43.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "mailparser": "^3.9.1",
    "tar": "^7.5.9",
    "minimatch": "^10.2.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'npm run type:check'"
    ]
  }
}
