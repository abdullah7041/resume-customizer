{
  "name": "resume-customizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fast": "vite",
    "dev:netlify": "netlify dev",
    "build": "node scripts/build.mjs",
    "build:vite": "vite build",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type:check": "tsc --noEmit",
    "quality:check": "npm run lint && npm run type:check && npm run test",
    "quality:parallel": "npm-run-all --parallel lint type:check test",
    "quality:fix": "npm run lint:fix && npm run type:check && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "cleanup": "node -e \"const fs=require('fs');const files=['unified-pipeline.js','test-local.sh','test-parse-resume.ps1','debug_output.png','deno.lock','scripts/debug-gemini.js','LOCAL_TESTING_GUIDE.md'];files.forEach(f=>{try{fs.unlinkSync(f);console.log('Deleted:',f)}catch(e){if(e.code!=='ENOENT')console.error('Error:',f,e.message)}});console.log('Cleanup complete!')\""
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.71",
    "@netlify/functions": "^5.1.2",
    "@sentry/node": "^10.42.0",
    "@sentry/react": "^10.42.0",
    "@supabase/supabase-js": "^2.99.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.4",
    "clsx": "^2.1.1",
    "docx": "^9.6.0",
    "dotenv": "^17.3.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.35.2",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.17",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-cookie": "^3.0.5",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "mixpanel-browser": "^2.75.0",
    "nanoid": "^5.1.6",
    "pdfjs-dist": "^5.5.207",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^16.5.6",
    "react-joyride": "^2.9.3",
    "resend": "^6.9.3",
    "supabase": "^2.77.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "optionalDependencies": {
    "@sparticuz/chromium": "^143.0.4",
    "puppeteer-core": "^24.38.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@netlify/dev": "^4.14.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.4.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "@vitest/eslint-plugin": "^1.6.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "npm-run-all": "^4.1.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "mailparser": "^3.9.1",
    "tar": "^7.5.9",
    "minimatch": "^10.2.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'tsc --noEmit'"
    ]
  }
}
