# ===========================================
# Watheq Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# --- Client-side (VITE_ prefix, exposed to browser) ---
# Supabase browser client base URL. Use the Supabase project URL, or the verified
# Supabase custom auth/API domain after DNS, TLS, and Supabase verification.
# Do not set this to the Watheq app URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Fixed post-login return URL for production OAuth redirects.
# Local development falls back to the current localhost origin/path.
VITE_SUPABASE_REDIRECT_URL=https://watheqai.app
VITE_SENTRY_DSN=https://your-sentry-dsn
VITE_MIXPANEL_TOKEN=your-mixpanel-token

# --- Server-side (Netlify Functions only) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
OPENROUTER_API_KEY=your-openrouter-key
GEMINI_API_KEY=your-gemini-key

# --- Optional Services ---
RESEND_API_KEY=your-resend-key
RESEND_SENDER_EMAIL=hello@watheqai.app
RESEND_SENDER_NAME=Watheq
SENTRY_DSN=your-server-sentry-dsn
UPSTASH_REDIS_REST_URL=your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
ADMIN_SECRET=change-me-in-production
# Manual trigger auth for cron-* functions
CRON_SECRET=change-me-in-production
# OpenRouter HTTP-Referer attribution (openrouter-client.js / openrouter-stream.js)
SITE_URL=https://watheqai.app
# Salt for strategic-reality-check input hashing; unsalted fallback when unset
STRATEGIC_REALITY_CHECK_HASH_SECRET=change-me-in-production

# --- Netlify auto-set ---
# URL (set by Netlify, used as fallback in batch-api)
# NETLIFY (set by Netlify, used for chromium detection)
# CONTEXT (set by Netlify, used for Sentry environment)
