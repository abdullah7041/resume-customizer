{
    "files": {
        "read": [
            "CLAUDE.md",
            "CLAUDE_CODE_BEST_PRACTICES.md",
            ".agent/AUTOMATIC_PROTOCOLS.md"
        ]
    },
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx tsc --noEmit 2>&1 | head -20",
                        "timeout": 60
                    }
                ]
            }
        ]
    }
}